# Copy to .env and fill in. Everything is optional except secrets for production.
JWT_SECRET=change-me
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# LLM: "openai" | "anthropic" | empty for the rule-based fallback
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# OAuth apps (redirect URI: $BACKEND_URL/connections/<provider>/callback)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
